# Configure em Vercel > Project > Settings > Environment Variables
# Senha longa e exclusiva (mínimo de 16 caracteres); nunca inclua o valor real no GitHub
SALDO_PASSWORD=
# Segredo aleatório com pelo menos 32 caracteres; diferente da senha
SALDO_SESSION_SECRET=
# String de conexão PostgreSQL, obtida do provedor de banco
DATABASE_URL=
